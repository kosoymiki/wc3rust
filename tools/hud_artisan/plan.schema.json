{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kosoymiki/wc3rust/blob/tools/hud-artisan-v1/tools/hud_artisan/plan.schema.json",
  "title": "HUD Artisan Generation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "schema_version",
    "version",
    "theme",
    "seed",
    "engine_contract",
    "source_manifest_sha256",
    "job_count",
    "jobs",
    "atlas"
  ],
  "properties": {
    "tool": {
      "const": "HUD Artisan"
    },
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "enum": [
        "classic-modern",
        "human-gold",
        "orc-iron",
        "undead-obsidian"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "engine_contract": {
      "type": "boolean"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_count": {
      "type": "integer",
      "minimum": 1
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "job.schema.json"
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "width",
        "height",
        "cells"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y",
              "w",
              "h",
              "source_asset",
              "source_file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "minimum": 1
              },
              "h": {
                "type": "integer",
                "minimum": 1
              },
              "source_asset": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
