{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUD Artisan independent visual review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "jobs_sha256",
    "reviewers",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "jobs_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "provider",
          "model",
          "role",
          "independent",
          "session_id",
          "review_prompt",
          "review_prompt_sha256",
          "raw_response_file",
          "raw_response_sha256"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "art_director",
              "red_team"
            ]
          },
          "independent": {
            "const": true
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 8
          },
          "review_prompt": {
            "type": "string",
            "minLength": 80
          },
          "review_prompt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_response_file": {
            "type": "string",
            "minLength": 1
          },
          "raw_response_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 2
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer_id",
            "image_sha256",
            "scores",
            "blockers",
            "improvements",
            "verdict",
            "confidence",
            "rationale"
          ],
          "properties": {
            "reviewer_id": {
              "type": "string"
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "semantic_readability",
                "silhouette_at_native_size",
                "material_credibility",
                "lighting_coherence",
                "value_hierarchy",
                "craftsmanship",
                "style_cohesion",
                "state_consistency",
                "engine_fitness",
                "originality_and_ip_safety"
              ],
              "properties": {
                "semantic_readability": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "silhouette_at_native_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "material_credibility": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "lighting_coherence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "value_hierarchy": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "craftsmanship": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "style_cohesion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "state_consistency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "engine_fitness": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "originality_and_ip_safety": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "improvements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verdict": {
              "enum": [
                "approve",
                "reject"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0.95,
              "maximum": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 80
            }
          }
        }
      }
    }
  }
}
