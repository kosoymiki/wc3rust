{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUD Artisan ComfyUI adapter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_file",
    "node_inputs",
    "output_node_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "workflow_file": {
      "type": "string",
      "minLength": 1
    },
    "node_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_prompt",
        "negative_prompt",
        "width",
        "height",
        "seed"
      ],
      "properties": {
        "positive_prompt": {
          "$ref": "#/$defs/nodeInput"
        },
        "negative_prompt": {
          "$ref": "#/$defs/nodeInput"
        },
        "width": {
          "$ref": "#/$defs/nodeInput"
        },
        "height": {
          "$ref": "#/$defs/nodeInput"
        },
        "seed": {
          "$ref": "#/$defs/nodeInput"
        }
      }
    },
    "output_node_id": {
      "type": "string",
      "minLength": 1
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "max_wait_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "poll_interval_seconds": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 30
    }
  },
  "$defs": {
    "nodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "input"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
