{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUD Artisan ComfyUI adapter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_file",
    "node_inputs",
    "output_node_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "workflow_file": {
      "type": "string",
      "minLength": 1
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "Optional SHA-256 pin for the exact local workflow JSON file."
    },
    "node_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_prompt",
        "negative_prompt",
        "width",
        "height",
        "seed"
      ],
      "properties": {
        "positive_prompt": {
          "$ref": "#/$defs/nodeInput"
        },
        "negative_prompt": {
          "$ref": "#/$defs/nodeInput"
        },
        "width": {
          "$ref": "#/$defs/nodeInput"
        },
        "height": {
          "$ref": "#/$defs/nodeInput"
        },
        "seed": {
          "$ref": "#/$defs/nodeInput"
        }
      }
    },
    "output_node_id": {
      "type": "string",
      "minLength": 1
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "max_wait_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "poll_interval_seconds": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 30
    },
    "workflow_format": {
      "enum": [
        "api",
        "ui",
        "auto"
      ],
      "default": "api"
    },
    "alpha_strategy": {
      "enum": [
        "preserve",
        "chroma_key"
      ],
      "default": "preserve"
    },
    "chroma_key_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        0,
        255
      ]
    },
    "chroma_key_tolerance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255,
      "default": 48
    }
  },
  "$defs": {
    "nodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "input"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
