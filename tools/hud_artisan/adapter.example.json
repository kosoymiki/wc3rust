{
  "schema_version": 1,
  "name": "comfyui-local",
  "provider": "ComfyUI",
  "model": "replace-with-checkpoint-and-workflow-revision",
  "license": "declare-the-applicable-model-and-output-license",
  "working_directory": "../..",
  "command": [
    "python3",
    "tools/hud_artisan/comfyui_adapter.py",
    "--config",
    "build/hud-artisan/comfyui.json",
    "--job-json",
    "{job_json}",
    "--output",
    "{output_path}"
  ],
  "environment": [
    "COMFYUI_URL"
  ],
  "timeout_seconds": 1900,
  "retries": 1,
  "max_parallel": 1,
  "references": [],
  "postprocessing": []
}
