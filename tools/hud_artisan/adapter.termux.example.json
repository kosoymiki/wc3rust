{
  "schema_version": 1,
  "name": "termux-comfyui-z-image-local",
  "provider": "ComfyUI local (Termux)",
  "model": "Z-Image Turbo BF16 + Qwen 3 4B CLIP + ae.safetensors VAE; AuraFlow shift=3; KSampler 8 steps / CFG 1 / res_multistep / simple",
  "license": "Record exact checkpoint/text-encoder license from their local model cards before redistribution",
  "working_directory": "../..",
  "command": [
    "python3",
    "tools/hud_artisan/comfyui_adapter.py",
    "--config",
    "build/hud-artisan/comfyui.json",
    "--job-json",
    "{job_json}",
    "--output",
    "{output_path}"
  ],
  "environment": [
    "COMFYUI_URL"
  ],
  "timeout_seconds": 3700,
  "retries": 1,
  "max_parallel": 1,
  "references": [],
  "postprocessing": [
    "chroma_key_background",
    "frame_aperture_cutout",
    "lanczos_native_downsample"
  ],
  "dependency_files": [
    "~/src/comfyui-termux/default_workflow.json"
  ]
}
